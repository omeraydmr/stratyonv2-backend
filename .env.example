# Copy this file to .env and fill in all values

# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stratyon
DB_USER=stratyon
DB_PASSWORD=change_me

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change_me_use_a_32_char_secret_here
JWT_EXPIRATION_MS=86400000

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=stratyon-reports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Anthropic Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-5
CLAUDE_MAX_TOKENS=1024

# ─── Google Analytics 4 ──────────────────────────────────────────────────────
GA4_PROPERTY_ID=
# Absolute path to your service account JSON key file
GA4_SERVICE_ACCOUNT_JSON=

# ─── Google Ads ──────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# 10-digit customer ID, no dashes
GOOGLE_ADS_CUSTOMER_ID=

# ─── Meta Marketing API ──────────────────────────────────────────────────────
META_ACCESS_TOKEN=
# Format: act_XXXXXXXXX
META_AD_ACCOUNT_ID=
